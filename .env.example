# Copy to .env and fill in the values from your Supabase project
# (Project Settings -> API). Only the PUBLIC anon/publishable key goes here.
# NEVER put the service_role key in this file or anywhere in the extension.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY
